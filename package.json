{
  "name": "slink-retail",
  "version": "0.2.0",
  "private": true,
  "description": "Slink retail operations application",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:native": "pnpm db:postgres:start && node server/index.js",
    "dev": "node server/dev.js",
    "dev:watch": "node --watch server/dev.js",
    "db:postgres:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres-local.ps1 start",
    "db:postgres:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres-local.ps1 stop",
    "db:postgres:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres-local.ps1 status",
    "db:migrate": "node server/migrate.js",
    "db:backup": "node scripts/postgres-backup.js create",
    "db:backup:verify": "node scripts/postgres-backup.js verify",
    "db:restore": "node scripts/postgres-backup.js restore",
    "db:import:pglite": "node server/import-pglite-to-postgres.js",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.5",
    "fastify": "^5.7.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
